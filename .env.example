TELEGRAM_BOT_TOKEN=
TYPESAFE_API_KEY=
DATABASE_URL=

# Optional tuning. Defaults are shown.
JEV_MODEL=jev-1.13.0
SPAM_THRESHOLD=0.81
JEV_TIMEOUT_MS=8000
# Persistent positive verdict cache (requires DATABASE_URL); false disables only cache.
SPAM_CACHE_ENABLED=true
# Primary classifier endpoint: any Jev wire-compatible /v1/systemone server.
# Switching to self-hosted = point JEV_URL/JEV_MODEL/TYPESAFE_API_KEY at it.
JEV_URL=https://api.typesafe.ai/v1/systemone

# Optional shadow classifier: same requests, verdict logged as `shadow_analyzed`, never deletes.
SHADOW_URL=
SHADOW_API_KEY=
SHADOW_MODEL=multilingual
SHADOW_TIMEOUT_MS=30000

# Opt-in: store Jev requests (incl. message/profile text) + answers for distillation; pruned after N days.
TRAINING_CAPTURE=false
TRAINING_CAPTURE_DAYS=30
